@implements MarkdownConverter.WebApp.Core.Views.IBibliographyView

<div class="bib-upload">
    @if (Presenter.ViewModel.IsLoaded)
    {
        <span class="bib-info" title="@Presenter.ViewModel.BibFileName">
            Bib: @Presenter.ViewModel.EntryCount entries
        </span>
        <button type="button"
                class="btn btn-sm"
                @onclick="OnClear"
                title="Remove bibliography"
                aria-label="Remove bibliography">x</button>
    }
    else
    {
        <label class="btn btn-sm btn-bib file-upload-button"
               title="Upload .bib bibliography file">
            .bib
            <InputFile OnChange="OnFileSelected"
                       accept=".bib"
                       class="file-input-overlay"
                       aria-label="Upload bibliography file" />
        </label>
    }
</div>
