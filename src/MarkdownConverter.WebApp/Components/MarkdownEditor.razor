@implements MarkdownConverter.WebApp.Core.Views.IEditorView

<div class="editor-container">
    <div class="editor-header">
        <span class="editor-filename">@TabPresenter.ActiveTab.FileName</span>
        @if (TabPresenter.ActiveTab.IsDirty)
        {
            <span class="editor-dirty" title="Unsaved changes">*</span>
        }
        <span class="editor-stats"
              aria-label="Line @TabPresenter.ActiveTab.LineCount, @TabPresenter.ActiveTab.WordCount words, @TabPresenter.ActiveTab.CharCount characters">
            <span aria-hidden="true">Ln @TabPresenter.ActiveTab.LineCount</span>
            <span class="editor-stat-words" aria-hidden="true">
                <span class="editor-stat-wide">&middot; @TabPresenter.ActiveTab.WordCount words</span>
                <span class="editor-stat-compact">&middot; @TabPresenter.ActiveTab.WordCount wd</span>
            </span>
            <span class="editor-stat-characters" aria-hidden="true">
                &middot; @TabPresenter.ActiveTab.CharCount chars
            </span>
        </span>
    </div>

    @if (_showFind)
    {
        <AppFindBar @ref="_findBar"
                    ShowReplace="_showReplace"
                    ShowReplaceChanged="OnShowReplaceChanged"
                    OnClose="OnFindBarClosed"
                    OnAfterFindChanged="RenderHighlightsAsync" />
    }

    <div class="editor-mirror-wrap">
        <div class="editor-mirror" aria-hidden="true"></div>
        <textarea @key="TabPresenter.ActiveTab.Id"
                  class="editor-textarea"
                  @oninput="OnInput"
                  @ondragover:preventDefault="true"
                  @ondrop:preventDefault="true"
                  @ondrop="OnDrop"
                  value="@TabPresenter.ActiveTab.MarkdownText"
                  aria-label="Markdown source"
                  placeholder="Start writing Markdown here..."
                  spellcheck="false"></textarea>
    </div>
</div>
