@namespace MarkdownConverter.WebApp.Components.Primitives

<div id="@Id" class="find-bar">
    <AppTextInput @ref="_findInput"
                  CssClass="find-input find-query-input"
                  Value="@_findText"
                  ValueChanged="OnFindTextChanged"
                  OnKeyDown="OnFindKeyDown"
                  AriaLabel="Find query"
                  Placeholder="Find..." />
    @if (ShowReplace)
    {
        <AppTextInput CssClass="find-input find-replacement-input"
                      Value="@_replaceText"
                      ValueChanged="OnReplaceTextChanged"
                      OnKeyDown="OnReplaceKeyDown"
                      AriaLabel="Replacement text"
                      Placeholder="Replace..." />
        <AppButton Size="ButtonSize.Sm"
                   CssClass="find-replace-current"
                   OnClick="OnReplace"
                   Disabled="@(!_canReplaceCurrent)"
                   Title="Replace current match">Replace</AppButton>
        <AppButton Size="ButtonSize.Sm"
                   CssClass="find-replace-all"
                   OnClick="OnReplaceAll"
                   Title="Replace All">All</AppButton>
        <span class="find-actions-break" aria-hidden="true"></span>
    }
    <AppToggleButton Active="@_useCaseSensitive"
                     OnToggle="ToggleCaseSensitive"
                     Label="Aa"
                     Title="Match case (Aa)" />
    <AppToggleButton Active="@_useWholeWord"
                     OnToggle="ToggleWholeWord"
                     Label="W"
                     Title="Match whole word" />
    <AppToggleButton Active="@_useRegex"
                     Invalid="@_invalidRegex"
                     OnToggle="ToggleRegex"
                     Label=".*"
                     Title="Use regular expression" />
    <AppToggleButton Active="@_useInSelection"
                     OnToggle="ToggleInSelection"
                     Label="⇪"
                     Title="Find in selection" />
    <AppIconButton IconClass="btn btn-sm find-prev"
                   OnClick="OnFindPrev"
                   Title="Previous (Shift+Enter)">&uarr;</AppIconButton>
    <AppIconButton IconClass="btn btn-sm find-next"
                   OnClick="OnFindNext"
                   Title="Next (Enter)">&darr;</AppIconButton>
    <AppButton Size="ButtonSize.Sm"
               CssClass="find-replace-toggle"
               OnClick="ToggleReplace"
               Title="Toggle Replace (Ctrl+H)">
        @(ShowReplace ? "Find" : "Replace")
    </AppButton>
    <span class="find-count @(_invalidRegex ? "find-count-invalid" : "")">@_matchInfo</span>
    <AppIconButton IconClass="btn btn-sm find-close"
                   OnClick="OnCloseClicked"
                   Title="Close find">&times;</AppIconButton>
</div>
