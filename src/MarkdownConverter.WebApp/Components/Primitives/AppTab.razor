@namespace MarkdownConverter.WebApp.Components.Primitives
@using MarkdownConverter.WebApp.Core.ViewModels

<div class="tab @(IsActive ? "tab-active" : "") @(IsDragOver ? "tab-drag-over" : "")"
     @onclick="OnClick"
     draggable="true"
     @ondragstart="OnDragStart"
     @ondragover:preventDefault="true"
     @ondragover="OnDragOver"
     @ondragleave="OnDragLeave"
     @ondrop:preventDefault="true"
     @ondrop="OnDrop"
     @ondragend="OnDragEnd"
     title="@Tab.FileName">
    @if (IsRenaming)
    {
        <AppTextInput CssClass="tab-rename-input"
                      Value="@RenameText"
                      ValueChanged="OnRenameTextChanged"
                      OnBlur="OnRenameBlur"
                      OnKeyDown="OnRenameKeyDown"
                      StopClickPropagation="true"
                      AutoFocus="true" />
    }
    else
    {
        <span class="tab-name"
              @ondblclick:stopPropagation="true"
              @ondblclick="OnStartRename">@TruncateName(Tab.FileName)</span>
    }
    @if (Tab.IsDirty)
    {
        <span class="tab-dirty">&bull;</span>
    }
    @if (!IsRenaming)
    {
        <AppIconButton IconClass="tab-rename"
                       LucideIcon="pencil"
                       OnClick="OnStartRename"
                       Title="Rename tab (double-click)" />
    }
    <AppIconButton IconClass="tab-close"
                   OnClick="OnClose"
                   Title="Close tab">&times;</AppIconButton>
</div>
