@inherits LayoutComponentBase

<div class="app-container @(_isDark ? "dark" : "light")">
    <header class="app-toolbar" aria-label="Application toolbar">
        <div class="toolbar-left">
            <div class="app-brand">
                <span class="app-logo">MD Converter</span>
                <span class="app-tagline">Ink &amp; Paper</span>
            </div>
        </div>
        <div class="toolbar-center">
            <Toolbar />
        </div>
        <div class="toolbar-right">
            <ThemeToggle IsDark="@_isDark" OnToggle="@ToggleTheme" />
        </div>
    </header>
    <main class="app-main">
        @Body
    </main>
    <ToastContainer />
    <ErrorDetailsDialog />
</div>
